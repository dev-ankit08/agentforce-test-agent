# Anthropic API key. Required for design / execute (judge+hallucination) / report
# has no LLM step. There is no stub/mock mode -- every Claude call is real.
ANTHROPIC_API_KEY=

# Salesforce org alias, already authenticated via the `sf` CLI on this machine
# (run `sf org list` to confirm it shows "Connected"). There is no separate
# token/URL to configure -- the Agent API access token is obtained from this
# `sf` session at run time.
AGENTFORCE_SF_ORG_ALIAS=

# The deployed AgentScript agent's Agent API agent id (or developer name),
# from Setup > Agents in the target org.
AGENTFORCE_AGENT_API_NAME=
